# Soroban Cookbook — Documentation site environment variables
#
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.
#
# These variables are read at BUILD TIME by Docusaurus / Node.
# They are embedded in the browser bundle as static strings —
# treat them as semi-public (use project-scoped DSNs, not org-level).

# ── Sentry error monitoring (issue #136) ─────────────────────────────────────
# Obtain from: Sentry dashboard → Your Project → Settings → SDK Setup → DSN
# When blank, Sentry is not initialised (safe for local development).
SENTRY_DSN=

# Sentry environment tag — helps filter events in the Sentry dashboard.
# Defaults to NODE_ENV when not set.
SENTRY_ENVIRONMENT=production

# Sentry release tag — should match your semver release or git SHA.
# Defaults to npm_package_version when not set.
SENTRY_RELEASE=

# ── Newsletter endpoint (existing) ───────────────────────────────────────────
# POST endpoint accepting JSON { "email": string }
NEWSLETTER_ENDPOINT=

# ── Discord invite (existing) ─────────────────────────────────────────────────
DISCORD_INVITE_URL=
