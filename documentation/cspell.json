{
  "version": "0.2",
  "language": "en",
  "dictionaries": ["customWords"],
  "dictionaryDefinitions": [
    {
      "name": "customWords",
      "path": "./cspell-custom-words.txt",
      "addWords": true
    }
  ],
  "files": ["docs/**/*.{md,mdx}", "README.md"],
  "ignorePaths": [
    "node_modules/**",
    "build/**",
    "*.lock",
    "bun.lock",
    "package-lock.json"
  ],
  "ignoreRegExpList": [
    "/\\b[SCG][A-Z0-9]{12,}\\b/",
    "/[A-Za-z0-9+/]{25,}={0,2}/",
    "/\\.\\.\\.[A-Za-z0-9]{3,}/"
  ],
  "flagWords": []
}
