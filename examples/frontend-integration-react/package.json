{
  "name": "soroban-counter-react",
  "version": "0.1.0",
  "private": true,
  "description": "React + Freighter wallet integration example for the Soroban Cookbook counter contract.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@stellar/freighter-api": "4.1.0",
    "@stellar/stellar-sdk": "13.1.0",
    "buffer": "6.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@vitejs/plugin-react": "4.3.4",
    "@vitest/ui": "2.1.8",
    "jsdom": "25.0.1",
    "typescript": "5.6.3",
    "vite": "6.0.5",
    "vitest": "2.1.8"
  }
}
