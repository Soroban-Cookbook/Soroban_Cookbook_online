# ─────────────────────────────────────────────────────────────────────────────
# Soroban Counter – React Integration Example
# .env.example
#
# Copy this file to .env and fill in your values.
# NEVER commit your .env file or put real secret keys here.
# ─────────────────────────────────────────────────────────────────────────────

# The Stellar RPC endpoint to use.
# Default: SDF public Testnet endpoint (no API key required for development).
# For production: use a dedicated RPC provider — see docs/getting-started/api-security.md
VITE_STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# The deployed contract ID for the counter contract on Testnet.
# Deploy the contract from examples/counter/ and paste the resulting address here.
# See docs/getting-started/deploy-testnet.md for deployment instructions.
# Example address format: CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAD2KM
VITE_CONTRACT_ID=

# Network passphrase. Do not change this unless you are targeting a different network.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
